# Echo Gate MCP bridge configuration. Copy to mcp-bridge/.env (it is
# git-ignored) or export the variables in your shell instead.

# Base URL of a RUNNING Echo Gate gateway.
ECHO_GATE_BASE_URL=http://localhost:8000

# Tenant API key sent as X-API-Key on chat/cache tools. Required there.
# Mint one via the gateway (api_keys module); never commit the real value.
ECHO_GATE_API_KEY=

# Admin key sent as X-Admin-Key by echo_gate_semantic_cache_search (scope
# cache:read). Tenant keys are rejected on the cache diagnostics. Create one
# with: python -m app.scripts.create_admin_key create
ECHO_GATE_ADMIN_KEY=

# Optional tenant whose cache the semantic-cache diagnostic inspects. Unset
# means the anonymous scope (what an admin key resolves to).
ECHO_GATE_TENANT_ID=

# Per-request timeout in seconds (provider calls can be slow).
ECHO_GATE_TIMEOUT_SECONDS=120
