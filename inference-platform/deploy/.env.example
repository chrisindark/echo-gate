# Model pins for the Infinity vector-worker pool.
#
# These must match models.lock.yaml. The lock is the authority; this file is how
# it reaches the container. `python tools/pin_models.py --check` verifies the two
# have not drifted.

EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANK_MODEL=BAAI/bge-reranker-base
RELEVANCE_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
NLI_MODEL=cross-encoder/nli-deberta-v3-small

# cpu | cuda | mps. On a Linux host without a GPU, cpu is correct — do not set
# cuda "just in case", it fails at startup rather than degrading.
INFERENCE_DEVICE=cpu
INFERENCE_BATCH_SIZE=32

# Bind address for the published port. Loopback keeps the engine off the public
# interface; consumers on the docker network reach it by service name.
INFERENCE_BIND=127.0.0.1
