# Base URL of the Echo Gate gateway used by the browser bundle.
# Inlined at build time by Next.js (NEXT_PUBLIC_*), so it must be set when
# running `next build` and cannot be changed at runtime.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional canonical URL for metadata, robots.txt, and sitemap.xml.
# On Vercel, VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL are used automatically if unset.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Auth for Production SaaS deployments
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional comma-separated OAuth providers enabled in your Supabase dashboard (e.g. github,google)
NEXT_PUBLIC_SUPABASE_OAUTH_PROVIDERS=
