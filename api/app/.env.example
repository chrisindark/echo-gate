PROJECT_NAME=echo-gate
VERSION=0.1.0

OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
CLAUDE_API_KEY=

OPENAI_BASE_URL=
GROQ_BASE_URL=
OPENROUTER_BASE_URL=
CLAUDE_BASE_URL=

OLLAMA_URL=
REDIS_URL=
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_REPLICATION_FACTOR=
QDRANT_WRITE_CONSISTENCY_FACTOR=
DATABASE_URL=postgresql+psycopg://echo_gate_app:echo_gate_app@localhost:5432/echo_gate
DATABASE_URL_READ=postgresql+psycopg://echo_gate_app:echo_gate_app@localhost:5432/echo_gate
# Owner credentials used only by Alembic (RLS does not apply to table owners).
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/echo_gate
DB_APP_ROLE=echo_gate_app
DB_APP_PASSWORD=echo_gate_app
CELERY_BROKER_URL=

# Model Caching
HF_HOME=
# Pin the extracted BM25 model dir to skip fastembed's cache resolution.
BM25_MODEL_PATH=
# fastembed's own artifact cache (distinct from HF_HOME).
FASTEMBED_CACHE_PATH=
# true = never download BM25 at runtime (the container bakes the model in).
BM25_LOCAL_FILES_ONLY=

# Redis Configurations
REDIS_TTL=3600

# LLM Router Service Configurations
# Cache mode: disabled | shadow | active. When unset, derives to `active` if any
# USE_* flag below is "true", otherwise `disabled`.
CACHE_MODE=
SHADOW_SAMPLE_RATE=
SHADOW_JUDGE_ENABLED=
SHADOW_READINESS_MIN_EVALUATIONS=
SHADOW_READINESS_MIN_HIT_RATE=
SHADOW_READINESS_MIN_EQUIVALENCE_RATE=
CACHE_AUDIT_ENABLED=
CACHE_AUDIT_SAMPLE_RATE=
CACHE_AUDIT_EVICT_ON_FAILURE=
CACHE_CALIBRATION_ALPHA=
CACHE_CALIBRATION_MODERATE_ALPHA=
CACHE_CALIBRATION_MIN_SAMPLES=
USE_REDIS_EXACT_MATCHING=
USE_QDRANT_EXACT_MATCHING=
USE_QDRANT_SEMANTIC_MATCHING=
USE_FALLBACK_LLM=
DEFAULT_LLM_SERVICE=
FALLBACK_LLM_SERVICE=
FALLBACK_LLM_MODEL=
LLM_PROVIDER_TIMEOUT_SECONDS=
HTTP_CLIENT_TIMEOUT_SECONDS=
LLM_MAX_RETRIES=
RETRY_BACKOFF_INITIAL_SECONDS=
RETRY_BACKOFF_MAX_SECONDS=
STREAM_MAX_CONTENT_BYTES=

# Qdrant Cache Configurations
QDRANT_DENSE_SEARCH_HIGH_THRESHOLD=
QDRANT_SPARSE_SEARCH_HIGH_THRESHOLD=
QDRANT_SEARCH_LIMIT=
DEFAULT_CACHE_TTL_SECONDS=

# Value-aware cache retention
CACHE_RETENTION_ENABLED=
CACHE_RETENTION_MAX_TTL_SECONDS=
CACHE_RETENTION_PROTECT_THRESHOLD=
CACHE_RETENTION_GRACE_PERIOD_SECONDS=
CACHE_RETENTION_MAX_POINTS=

CACHE_CONFIDENCE_THRESHOLDS=
INTENT_TTL_SECONDS=

# Model Configurations & Versioning
EMBEDDING_MODEL_NAME=
EMBEDDING_VERSION=
SPARSE_EMBEDDING_VERSION=
CACHE_KEY_VERSION=
PROMPT_VERSION=
INTENT_PROMPT_VERSION=
INTENT_CLASSIFIER_VERSION=
CORE_QUERY_EXTRACTOR_VERSION=
RERANKER_VERSION=
JUDGE_PROMPT_VERSION=

# Observability & OpenTelemetry
OTEL_ENABLED=
OTEL_SERVICE_NAME=
OTEL_EXPORTER_OTLP_ENDPOINT=

USE_RERANKER_MODEL=
RERANKER_MODEL_NAME=
RERANKER_SCORING_MODE=

INTENT_CLASSIFIER_SERVICE=
INTENT_CLASSIFIER_MODEL=
INTENT_CLASSIFIER_TEMPERATURE=
INTENT_CLASSIFIER_TIMEOUT_SECONDS=
INTENT_CLASSIFIER_MAX_TOKENS=
INTENT_CLASSIFIER_REASONING_EFFORT=
INTENT_CLASSIFIER_MAX_RETRIES=

CORE_QUERY_EXTRACTOR_SERVICE=
CORE_QUERY_EXTRACTOR_MODEL=
CORE_QUERY_EXTRACTOR_TEMPERATURE=
CORE_QUERY_EXTRACTOR_MAX_TOKENS=

CROSS_ENCODER_RELEVANCE_MODEL=
CROSS_ENCODER_NLI_MODEL=

USE_RELEVANCE_MODEL=
USE_NLI_MODEL=

# Shared inference platform (required). Dense embeddings, reranking, relevance
# and NLI are served over HTTP by inference-platform/; the gateway has no
# in-process model path and refuses to start without a reachable engine that
# serves every role it needs.
INFERENCE_BASE_URL=http://localhost:7997
# Per-role endpoint overrides (optional; fall back to INFERENCE_BASE_URL if unset).
# Use these when scaling embedding, reranking, and NLI/classification independently.
INFERENCE_EMBED_URL=
INFERENCE_RERANK_URL=
INFERENCE_RELEVANCE_URL=
INFERENCE_NLI_URL=

INFERENCE_TIMEOUT_SECONDS=
# Optional per-role timeouts (fall back to INFERENCE_TIMEOUT_SECONDS):
INFERENCE_EMBED_TIMEOUT_SECONDS=
INFERENCE_RERANK_TIMEOUT_SECONDS=
INFERENCE_RELEVANCE_TIMEOUT_SECONDS=
INFERENCE_NLI_TIMEOUT_SECONDS=
INFERENCE_MAX_RETRIES=
# Dense dimension the engine serves; locked into the Qdrant collection.
INFERENCE_EMBEDDING_DIM=
# Optional pins. Empty = route by role (laptop/native backend). Production
# against Infinity must pin all three, since it routes by model id only.
INFERENCE_EMBED_MODEL=
INFERENCE_RERANK_MODEL=
INFERENCE_RELEVANCE_MODEL=
INFERENCE_NLI_MODEL=

EVALUATION_BATCH_SIZE=

LLM_JUDGE_SERVICE=
LLM_JUDGE_MODEL=
LLM_JUDGE_TEMPERATURE=
LLM_JUDGE_MAX_TOKENS=
