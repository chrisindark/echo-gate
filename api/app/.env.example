PROJECT_NAME=echo-gate
VERSION=0.1.0

# Provider API Keys
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
CLAUDE_API_KEY=

OPENAI_BASE_URL=
GROQ_BASE_URL=
OPENROUTER_BASE_URL=
CLAUDE_BASE_URL=

# Infrastructure & Storage
OLLAMA_URL=http://localhost:11434
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=embeddings_multivector
QDRANT_API_KEY=
QDRANT_REPLICATION_FACTOR=
QDRANT_WRITE_CONSISTENCY_FACTOR=

DATABASE_URL=postgresql+psycopg://echo_gate_app:echo_gate_app@localhost:5432/echo_gate
DATABASE_URL_READ=postgresql+psycopg://echo_gate_app:echo_gate_app@localhost:5432/echo_gate
# Owner credentials used only by Alembic (RLS does not apply to table owners).
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/echo_gate
DB_APP_ROLE=echo_gate_app
DB_APP_PASSWORD=echo_gate_app

# Database Connection Pool
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

# Celery Brokers & Results
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Model Caching
HF_HOME=
# Pin the extracted BM25 model dir to skip fastembed's cache resolution.
BM25_MODEL_PATH=
# fastembed's own artifact cache (distinct from HF_HOME).
FASTEMBED_CACHE_PATH=
# true = never download BM25 at runtime (the container bakes the model in).
BM25_LOCAL_FILES_ONLY=

# Redis Configurations
REDIS_TTL=3600

# LLM Router Service Configurations
# Cache mode: disabled | shadow | active. When unset, derives to `active` if any
# USE_* flag below is "true", otherwise `disabled`.
CACHE_MODE=shadow
SHADOW_SAMPLE_RATE=1.0
SHADOW_JUDGE_ENABLED=true
SHADOW_READINESS_MIN_EVALUATIONS=200
SHADOW_READINESS_MIN_HIT_RATE=0.05
SHADOW_READINESS_MIN_EQUIVALENCE_RATE=0.98

# Cache Audit Loop (Phase 2)
CACHE_AUDIT_ENABLED=true
CACHE_AUDIT_SAMPLE_RATE=0.02
CACHE_AUDIT_EVICT_ON_FAILURE=true

# Conformal Threshold Calibration (Phase 2)
CACHE_CALIBRATION_ALPHA=0.02
CACHE_CALIBRATION_MODERATE_ALPHA=0.05
CACHE_CALIBRATION_MIN_SAMPLES=10

USE_REDIS_EXACT_MATCHING=true
USE_QDRANT_EXACT_MATCHING=true
USE_QDRANT_SEMANTIC_MATCHING=true
USE_FALLBACK_LLM=true
DEFAULT_LLM_SERVICE=google-genai
FALLBACK_LLM_SERVICE=google-genai
FALLBACK_LLM_MODEL=gemini-3.1-flash-lite
LLM_PROVIDER_TIMEOUT_SECONDS=15.0
HTTP_CLIENT_TIMEOUT_SECONDS=120.0
LLM_MAX_RETRIES=0
RETRY_BACKOFF_INITIAL_SECONDS=1
RETRY_BACKOFF_MAX_SECONDS=10
RETRY_AFTER_DEFAULT_SECONDS=5
STREAM_MAX_CONTENT_BYTES=2097152
STREAM_CACHE_PACING_ENABLED=true
STREAM_CACHE_PACING_DELAY_MS=8.0
STREAM_CACHE_WORDS_PER_CHUNK=3

# Circuit Breaker & Concurrency Bulkheads
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT_SECONDS=30.0
CIRCUIT_BREAKER_HALF_OPEN_SUCCESS_THRESHOLD=2
GLOBAL_MAX_CONCURRENCY=100
PROVIDER_MAX_CONCURRENCY=25
BULKHEAD_ACQUIRE_TIMEOUT_SECONDS=0.0
ALLOWED_MODELS_JSON=
MODEL_ALIASES_JSON=

# Qdrant Cache Configurations
QDRANT_DENSE_SEARCH_HIGH_THRESHOLD=0.98
QDRANT_SPARSE_SEARCH_HIGH_THRESHOLD=0.33
QDRANT_SEARCH_LIMIT=10
DEFAULT_CACHE_TTL_SECONDS=86400

# Cost estimation
ESTIMATE_DEFAULT_COMPLETION_TOKENS=256

# Value-aware cache retention
CACHE_RETENTION_ENABLED=true
CACHE_RETENTION_MAX_TTL_SECONDS=2592000
CACHE_RETENTION_PROTECT_THRESHOLD=5.0
CACHE_RETENTION_GRACE_PERIOD_SECONDS=259200
CACHE_RETENTION_MAX_POINTS=0

CACHE_CONFIDENCE_THRESHOLDS=
INTENT_TTL_SECONDS=

# Model Configurations & Versioning
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_DEVICE=cpu
EMBEDDING_VERSION=v1
SPARSE_EMBEDDING_VERSION=v1
CACHE_KEY_VERSION=v1
PROMPT_VERSION=v1
INTENT_PROMPT_VERSION=v1
INTENT_CLASSIFIER_VERSION=v1
CORE_QUERY_EXTRACTOR_VERSION=v1
RERANKER_VERSION=v1
JUDGE_PROMPT_VERSION=v1

# Prompt Token Optimization Pipeline (Phase 5 / P3)
PROMPT_OPTIMIZATION_ENABLED=false
PROMPT_OPTIMIZATION_WHITESPACE=true
PROMPT_OPTIMIZATION_SESSION_DEDUP=true
PROMPT_OPTIMIZATION_JSON_TABLE=true
PROMPT_OPTIMIZATION_JSON_TABLE_MIN_ROWS=2
PROMPT_OPTIMIZATION_CCR_ENABLED=false
PROMPT_OPTIMIZATION_CCR_KEEP_LAST_N_TURNS=5
PROMPT_OPTIMIZATION_CCR_STRATEGY=condense
PROMPT_OPTIMIZATION_HEADROOM_ENABLED=false
PROMPT_OPTIMIZATION_HEADROOM_BUFFER=100
PROMPT_OPTIMIZATION_COMPRESS_ENABLED=false
PROMPT_OPTIMIZATION_COMPRESS_RATE=0.5
PROMPT_OPTIMIZATION_COMPRESS_METHOD=lexical
INFERENCE_COMPRESS_URL=
INFERENCE_COMPRESS_TIMEOUT_SECONDS=5.0
MODEL_CONTEXT_WINDOWS_JSON=

# Event bus (webhook sink, extension seam)
EVENTS_ENABLED=true
EVENTS_WEBHOOK_CACHE_MISS=
EVENTS_WEBHOOK_QUOTA_EXCEEDED=
EVENTS_WEBHOOK_PROVIDER_FAILURE=
EVENTS_WEBHOOK_AUDIT_FAILED=

# Observability & OpenTelemetry
OTEL_ENABLED=false
OTEL_SERVICE_NAME=echo-gate
OTEL_EXPORTER_OTLP_ENDPOINT=

# Anonymous usage telemetry (opt-in, default off)
TELEMETRY_ENABLED=false
TELEMETRY_ENDPOINT=
TELEMETRY_INTERVAL_SECONDS=86400
TELEMETRY_INSTANCE_ID=
TELEMETRY_DEPLOYMENT_MODE=self-hosted

USE_RERANKER_MODEL=true
RERANKER_MODEL_NAME=Alibaba-NLP/gte-reranker-modernbert-base
RERANKER_SCORING_MODE=multiplicative

INTENT_CLASSIFIER_SERVICE=groq
INTENT_CLASSIFIER_MODEL=openai/gpt-oss-20b
INTENT_CLASSIFIER_TEMPERATURE=0.0
INTENT_CLASSIFIER_TIMEOUT_SECONDS=2.5
INTENT_CLASSIFIER_MAX_TOKENS=500
INTENT_CLASSIFIER_REASONING_EFFORT=low
INTENT_CLASSIFIER_MAX_RETRIES=0

CORE_QUERY_EXTRACTOR_SERVICE=ollama
CORE_QUERY_EXTRACTOR_MODEL=qwen2.5-coder:1.5b
CORE_QUERY_EXTRACTOR_TEMPERATURE=0.0
CORE_QUERY_EXTRACTOR_MAX_TOKENS=200

CROSS_ENCODER_RELEVANCE_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
CROSS_ENCODER_NLI_MODEL=cross-encoder/nli-MiniLM2-L6-H768

USE_RELEVANCE_MODEL=true
USE_NLI_MODEL=true

# Shared inference platform (required)
INFERENCE_BASE_URL=http://localhost:7997
INFERENCE_DOCKER_BASE_URL=http://host.docker.internal:7997
OLLAMA_DOCKER_URL=http://host.docker.internal:11434

INFERENCE_EMBED_URL=
INFERENCE_RERANK_URL=
INFERENCE_RELEVANCE_URL=
INFERENCE_NLI_URL=
INFERENCE_TIMEOUT_SECONDS=5.0
INFERENCE_EMBED_TIMEOUT_SECONDS=
INFERENCE_RERANK_TIMEOUT_SECONDS=
INFERENCE_RELEVANCE_TIMEOUT_SECONDS=
INFERENCE_NLI_TIMEOUT_SECONDS=
INFERENCE_MAX_RETRIES=1
INFERENCE_EMBEDDING_DIM=384
INFERENCE_EMBED_MODEL=
INFERENCE_RERANK_MODEL=
INFERENCE_RELEVANCE_MODEL=
INFERENCE_NLI_MODEL=

EVALUATION_BATCH_SIZE=50

LLM_JUDGE_SERVICE=google-genai
LLM_JUDGE_MODEL=gemini-3.5-flash-lite
LLM_JUDGE_TEMPERATURE=0.0
LLM_JUDGE_MAX_TOKENS=200
