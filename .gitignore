# Python
*.py[cod]
*$py.class
*.py~
*.so
__pycache__/

# Model Caches (e.g., from Hugging Face, PyTorch, or other AI libraries)
.model_cache/
.cache/
*.pt
*.pth

# Virtual Environments
.venv/
venv/
ENV/
env/

# Environment / secrets files — local config must never be committed.
# Examples (*.env.example) are the only committed env files.
**/.env
**/.env.*
!**/.env.example

# Generated test-result artifacts (app/scripts/run_tests.py output)
run_test_results.csv

# IDE and OS configs
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store

# SQLite Database
sqlite3.db
sqlite3.db-shm
sqlite3.db-wal

# Celery
celerybeat-schedule
celerybeat-schedule-shm
celerybeat-schedule-wal
